@app.get("/weekly-report/prompt-snapshot/{report_filename}")
async def get_prompt_snapshot(report_filename: str):
    """리포트 생성 시 사용된 프롬프트 조회"""
    # weekly_report_2026-03-30_022051.md -> 2026-03-30_022051
    key = report_filename.replace("weekly_report_", "").replace(".md", "")

    # 해당 키와 매칭되는 스냅샷 찾기
    if not os.path.exists(_SNAPSHOT_DIR):
        raise HTTPException(status_code=404, detail="No snapshots found")

    # 정확히 매칭되는 파일 찾기 (날짜_시간)
    for fname in sorted(os.listdir(_SNAPSHOT_DIR), reverse=True):
        if fname.endswith(".json") and fname.replace(".json", "") == key:
            with open(os.path.join(_SNAPSHOT_DIR, fname), "r", encoding="utf-8") as f:
                return _json.load(f)

    # 날짜만 매칭 (타임스탬프 없는 레거시 파일용)
    date_part = key[:10] if len(key) >= 10 else key
    for fname in sorted(os.listdir(_SNAPSHOT_DIR), reverse=True):
        if fname.startswith(date_part):
            with open(os.path.join(_SNAPSHOT_DIR, fname), "r", encoding="utf-8") as f:
                return _json.load(f)

    raise HTTPException(status_code=404, detail="Snapshot not found for this report")


