@app.put("/weekly-report/prompt")
async def update_prompt(request: Request):
    """프롬프트 파일 업데이트"""
    body = await request.json()
    filename = body.get("filename", "")
    content = body.get("content", "")
    if filename not in ["system_prompt.txt", "report_format.txt"]:
        raise HTTPException(status_code=400, detail="Invalid filename")
    if not content:
        raise HTTPException(status_code=400, detail="content is required")

    import shutil
    filepath = os.path.join(_PROMPTS_DIR, filename)
    backup = filepath + ".bak"
    if os.path.exists(filepath):
        shutil.copy2(filepath, backup)

    with open(filepath, "w", encoding="utf-8") as f:
        f.write(content)

    # 이력 저장
    history = _load_prompt_history()
    history.insert(0, {
        "timestamp": _dt.utcnow().strftime("%Y-%m-%d %H:%M:%S UTC"),
        "filename": filename,
        "content": content,
    })
    history = history[:50]
    _save_prompt_history(history)

    return {"status": "saved", "filename": filename}

