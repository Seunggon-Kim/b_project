from google.cloud import bigquery as _bq
import re as _re

def _add_suite_filter(sql, suite_param_name="suite"):
    """SQL에 suite 필터를 서브쿼리로 감싸서 확실하게 적용."""
    sql = sql.rstrip().rstrip(";")
    order_match = _re.search(r"\nORDER BY[^\n]*(?:\n|$)", sql)
    if order_match:
        sql = sql[:order_match.start()]
    return f"SELECT * FROM (\n{sql}\n) _sub WHERE _sub.suite_number = @{suite_param_name}"


@app.get("/customer-transactions")
async def get_customer_transactions(suite: str = None, case_num: int = None):
    """고객별 거래 내역 조회 (CSV 다운로드용)."""
    if not suite or len(suite) > 10:
        raise HTTPException(status_code=400, detail="Valid suite parameter is required")

    import decimal as _decimal
    from weekly_report.bigquery_client import get_client

    SQL_DIR = "/home/ubuntu/dk-analytics/scripts/sql"
    client = get_client()

    cases = [case_num] if case_num and 1 <= case_num <= 5 else list(range(1, 6))
    all_rows = []
    for cn in cases:
        sql_path = os.path.join(SQL_DIR, f"case_{cn}.sql")
        if not os.path.exists(sql_path):
            continue
        with open(sql_path, "r", encoding="utf-8") as f:
            sql = f.read()
        sql = _add_suite_filter(sql)
        try:
            job_config = _bq.QueryJobConfig(
                query_parameters=[_bq.ScalarQueryParameter("suite", "STRING", suite)]
            )
            rows = client.query(sql, job_config=job_config).result()
            for row in rows:
                d = dict(row)
                for k, v in d.items():
                    if hasattr(v, "isoformat"):
                        d[k] = v.isoformat()
                    elif isinstance(v, _decimal.Decimal):
                        d[k] = float(v)
                all_rows.append(d)
        except Exception as e:
            print(f"Case {cn} query error for suite {suite}: {e}")
            continue

    all_rows.sort(key=lambda x: x.get("ship_date_kst", "") or "", reverse=True)
    return {"suite": suite, "count": len(all_rows), "transactions": all_rows}


@app.post("/customer-stats")
async def customer_stats(request: Request):
    """고객별 차트 데이터: BigQuery 집계만 (AI 호출 없음, 무료, 빠름)"""
    import decimal as _decimal
    from collections import defaultdict

    body = await request.json()
    suite = body.get("suite", "")
    year_filter = body.get("year", "all")  # "all", "2025", "2026"
    if not suite or len(suite) > 10:
        raise HTTPException(status_code=400, detail="Valid suite is required")

    from weekly_report.bigquery_client import get_client

    SQL_DIR = "/home/ubuntu/dk-analytics/scripts/sql"
    client = get_client()

    all_rows = []
    for case_num in range(1, 6):
        sql_path = os.path.join(SQL_DIR, f"case_{case_num}.sql")
        if not os.path.exists(sql_path):
            continue
        with open(sql_path, "r", encoding="utf-8") as f:
            sql = f.read()
        sql = _add_suite_filter(sql)
        try:
            job_config = _bq.QueryJobConfig(
                query_parameters=[_bq.ScalarQueryParameter("suite", "STRING", suite)]
            )
            rows = client.query(sql, job_config=job_config).result()
            for row in rows:
                d = dict(row)
                for k, v in d.items():
                    if hasattr(v, "isoformat"):
                        d[k] = v.isoformat()
                    elif isinstance(v, _decimal.Decimal):
                        d[k] = float(v)
                all_rows.append(d)
        except Exception as e:
            print(f"Stats Case {case_num} error for {suite}: {e}")
            continue

    # 연도 필터 적용
    if year_filter and year_filter != "all":
        all_rows = [r for r in all_rows if (r.get("ship_date_kst") or "").startswith(year_filter)]

    if not all_rows:
        raise HTTPException(status_code=404, detail="No transaction data found")

    def sf(v):
        try:
            return float(v) if v is not None else 0.0
        except (ValueError, TypeError):
            return 0.0

    total_rows = len(all_rows)
    total_profit = sum(sf(r.get("profit_krw")) for r in all_rows)
    total_revenue = sum(sf(r.get("revenue_krw", 0)) for r in all_rows)

    # Case별
    case_agg = defaultdict(lambda: {"count": 0, "profit": 0, "revenue": 0})
    for r in all_rows:
        c = str(r.get("profit_case", "?"))
        case_agg[c]["count"] += 1
        case_agg[c]["profit"] += sf(r.get("profit_krw"))
        case_agg[c]["revenue"] += sf(r.get("revenue_krw", 0))

    # 월별
    monthly = defaultdict(lambda: {"count": 0, "profit": 0, "revenue": 0})
    for r in all_rows:
        m = (r.get("ship_date_kst") or "")[:7]
        if m:
            monthly[m]["count"] += 1
            monthly[m]["profit"] += sf(r.get("profit_krw"))
            monthly[m]["revenue"] += sf(r.get("revenue_krw", 0))

    # 국가별 Top 10
    country_agg = defaultdict(lambda: {"count": 0, "profit": 0})
    for r in all_rows:
        cn = r.get("country_name_kr") or r.get("country_name") or r.get("country_code") or "?"
        country_agg[cn]["count"] += 1
        country_agg[cn]["profit"] += sf(r.get("profit_krw"))
    country_top = sorted(country_agg.items(), key=lambda x: x[1]["count"], reverse=True)[:10]

    # 판매자 Top 10
    merchant_agg = defaultdict(lambda: {"count": 0, "revenue": 0})
    for r in all_rows:
        m = r.get("package_merchant_clean") or r.get("package_merchant") or ""
        if m:
            merchant_agg[m]["count"] += 1
            merchant_agg[m]["revenue"] += sf(r.get("revenue_krw", 0))
    merchant_top = sorted(merchant_agg.items(), key=lambda x: x[1]["count"], reverse=True)[:10]

    # 캐리어별
    carrier_agg = defaultdict(lambda: {"count": 0, "profit": 0})
    for r in all_rows:
        cr = r.get("carrier") or "?"
        carrier_agg[cr]["count"] += 1
        carrier_agg[cr]["profit"] += sf(r.get("profit_krw"))

    # 수익 구성
    total_goods_profit = sum(sf(r.get("goods_profit_krw")) for r in all_rows)
    total_warehouse_profit = sum(sf(r.get("warehouse_profit_krw")) for r in all_rows)
    total_shipping_profit = sum(sf(r.get("shipping_profit_krw")) for r in all_rows)

    # 상품 카테고리 Top 5
    cat_agg = defaultdict(int)
    for r in all_rows:
        cat = r.get("product_category")
        if cat:
            cat_agg[cat] += 1
    cat_top = sorted(cat_agg.items(), key=lambda x: x[1], reverse=True)[:5]

    # 적자 패키지
    negative_count = sum(1 for r in all_rows if sf(r.get("profit_krw")) < 0)

    return {
        "suite": suite,
        "total": {
            "rows": total_rows,
            "revenue": round(total_revenue),
            "profit": round(total_profit),
            "profit_per_pkg": round(total_profit / total_rows) if total_rows else 0,
            "negative_count": negative_count,
            "negative_pct": round(negative_count / total_rows * 100, 1) if total_rows else 0,
        },
        "profit_composition": {
            "goods": round(total_goods_profit),
            "warehouse": round(total_warehouse_profit),
            "shipping": round(total_shipping_profit),
        },
        "by_case": {c: v for c, v in sorted(case_agg.items())},
        "by_month": {m: v for m, v in sorted(monthly.items())},
        "by_country": [{"name": c, **v} for c, v in country_top],
        "by_merchant": [{"name": m, **v} for m, v in merchant_top],
        "by_carrier": {c: v for c, v in sorted(carrier_agg.items(), key=lambda x: x[1]["count"], reverse=True)},
        "by_category": [{"name": c, "count": n} for c, n in cat_top],
    }


