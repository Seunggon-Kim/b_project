# ── AI Proxy ──────────────────────────────────────────────────────────────────
import os
from fastapi import Request

def _get_api_keys():
    """환경변수에서 모든 API 키를 수집 (ANTHROPIC_API_KEY, _2, _3, ...)"""
    keys = []
    primary = os.environ.get("ANTHROPIC_API_KEY", "")
    if primary:
        keys.append(primary)
    for i in range(2, 10):
        k = os.environ.get(f"ANTHROPIC_API_KEY_{i}", "")
        if k:
            keys.append(k)
    return keys


def _call_anthropic_with_failover(body, timeout=60):
    """API 키 failover: 크레딧 소진 시 자동으로 다음 키로 전환"""
    keys = _get_api_keys()
    if not keys:
        raise HTTPException(status_code=500, detail="No API keys configured")

    last_error = None
    for i, api_key in enumerate(keys):
        response = requests.post(
            "https://api.anthropic.com/v1/messages",
            headers={
                "x-api-key": api_key,
                "anthropic-version": "2023-06-01",
                "content-type": "application/json",
            },
            json=body,
            timeout=timeout,
        )
        result = response.json()

        # 크레딧 부족 또는 인증 에러면 다음 키로
        if response.status_code in (400, 401, 403):
            err_msg = str(result.get("error", {}).get("message", ""))
            if "credit" in err_msg.lower() or "api key" in err_msg.lower() or "auth" in err_msg.lower():
                print(f"API key #{i+1} failed ({err_msg[:60]}), trying next...")
                last_error = result
                continue

        return response, result

    # 모든 키 실패
    return None, last_error


@app.post("/ai-proxy")
async def ai_proxy(request: Request):
    """Anthropic API 프록시 - API 키 failover 지원"""
    body = await request.json()
    response, result = _call_anthropic_with_failover(body, timeout=120)

    if response is None:
        return JSONResponse(content=result or {"error": "All API keys exhausted"}, status_code=402)

    return JSONResponse(content=result, status_code=response.status_code)


@app.post("/github-dispatch")
async def github_dispatch(request: Request):
    """GitHub Actions workflow 트리거 프록시"""
    gh_token = os.environ.get("GITHUB_PAT", "")
    if not gh_token:
        raise HTTPException(status_code=500, detail="GitHub PAT not configured on server")

    body = await request.json()
    report_date = body.get("report_date", "")

    if not report_date:
        raise HTTPException(status_code=400, detail="report_date is required")

    response = requests.post(
        "https://api.github.com/repos/evan-dk/dk-analytics/dispatches",
        headers={
            "Authorization": f"token {gh_token}",
            "Accept": "application/vnd.github.v3+json",
            "Content-Type": "application/json",
        },
        json={
            "event_type": "generate-weekly-report",
            "client_payload": {"report_date": report_date}
        },
        timeout=30,
    )

    if response.status_code == 204:
        return {"status": "ok", "message": f"Report generation triggered for {report_date}"}
    else:
        return JSONResponse(content={"error": response.text}, status_code=response.status_code)


