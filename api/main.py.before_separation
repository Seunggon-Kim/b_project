from fastapi import BackgroundTasks
import asyncio

@app.post("/weekly-report/generate")
async def generate_report_endpoint(request: Request, background_tasks: BackgroundTasks):
    """주간 리포트 생성 트리거"""
    body = await request.json()
    report_date = body.get("report_date", "")
    if not report_date:
        raise HTTPException(status_code=400, detail="report_date is required")

    from weekly_report.report_generator import generate_weekly_report, get_status
    current = get_status(report_date)
    if current.get("status") == "running":
        return {"status": "already_running", "report_date": report_date}

    log_request(report_date, "running")
    background_tasks.add_task(generate_weekly_report, report_date)
    return {"status": "accepted", "report_date": report_date}


