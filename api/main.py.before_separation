@app.get("/weekly-report/files")
async def list_report_files():
    """GitHub API를 인증된 토큰으로 호출하여 리포트 파일 목록 반환"""
    gh_token = os.environ.get("GITHUB_PAT", "")
    headers = {"Accept": "application/vnd.github.v3+json"}
    if gh_token:
        headers["Authorization"] = f"token {gh_token}"

    import re
    pattern = re.compile(r'^weekly_report_\d{4}-\d{2}-\d{2}(_\d{6})?\.md$')

    response = requests.get(
        "https://api.github.com/repos/evan-dk/dk-analytics/contents/weekly-report",
        headers=headers,
        timeout=30,
    )
    if not response.ok:
        raise HTTPException(status_code=response.status_code, detail=response.text)

    files = response.json()
    result = [
        {"name": f["name"], "sha": f["sha"], "size": f["size"]}
        for f in files
        if isinstance(f, dict) and pattern.match(f.get("name", ""))
    ]
    result.sort(key=lambda x: x["name"], reverse=True)
    return result


